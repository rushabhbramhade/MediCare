# Medicare environment template.
#
# Copy this file to `.env` at the repository root for the API, workers and
# migration script. The web app reads a separate `apps/web/.env.local`
# (see apps/web/.env.example). Never commit real values.
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development

APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000
# Server-side web -> API calls (not exposed to the browser)
API_BASE_URL=http://localhost:4000

AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# OpenStreetMap tiles require no key. Replace only with a tile provider you
# are licensed to use, and keep the attribution correct.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# ---------------------------------------------------------------------------
# Database (local Docker defaults; replace for hosted Postgres)
# ---------------------------------------------------------------------------
POSTGRES_USER=medicare
POSTGRES_PASSWORD=medicare_local_only
POSTGRES_DB=medicare
POSTGRES_PORT=5432
DATABASE_URL=postgresql://medicare:medicare_local_only@localhost:5432/medicare
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Supabase Auth / Storage (optional locally)
# ---------------------------------------------------------------------------
# Empty values disable hosted auth in the web app. Patient routes then redirect
# to /login with a configuration notice instead of granting access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=medical-records

# JWT verification for the API (must match your Supabase project)
JWT_ISSUER=http://127.0.0.1:54321/auth/v1
JWT_AUDIENCE=authenticated
JWT_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# ---------------------------------------------------------------------------
# Redis / queues
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
QUEUE_PREFIX=medicare

# ---------------------------------------------------------------------------
# AI service
# ---------------------------------------------------------------------------
# disabled | openai-compatible
AI_PROVIDER=disabled
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=800
AI_RETRIEVAL_TOP_K=6
AI_EMBEDDING_MODEL=
# Shared secret for API -> AI service calls. Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=

# ---------------------------------------------------------------------------
# OCR / document extraction
# ---------------------------------------------------------------------------
OCR_PROVIDER=disabled
OCR_API_URL=
OCR_API_KEY=

# ---------------------------------------------------------------------------
# Maps and geocoding (geocoding is optional; the map itself uses OSM tiles)
# ---------------------------------------------------------------------------
GEOCODING_PROVIDER=disabled
GEOCODING_API_URL=
GEOCODING_API_KEY=

# ---------------------------------------------------------------------------
# SMS / email (generic HTTP providers; no vendor is hardcoded)
# ---------------------------------------------------------------------------
SMS_PROVIDER=disabled
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com

# ---------------------------------------------------------------------------
# Provider integrations (all disabled until a real contract exists)
# ---------------------------------------------------------------------------
PHARMACY_PROVIDER=disabled
PHARMACY_API_URL=
PHARMACY_API_KEY=

DOCTOR_PROVIDER=disabled
DOCTOR_API_URL=
DOCTOR_API_KEY=

AMBULANCE_PROVIDER=disabled
AMBULANCE_API_URL=
AMBULANCE_API_KEY=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# 32+ bytes, base64 or hex. Reserved for encrypting sensitive fields at rest.
# Not yet used by application code; do not assume encryption is active.
ENCRYPTION_KEY=

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100
AUTH_RATE_LIMIT_LIMIT=10

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true
METRICS_ENABLED=false
