# Medicare environment template.
#
# Copy this file to `.env` at the repository root for the API, workers and
# migration script. The web app reads a separate `apps/web/.env.local`
# (see apps/web/.env.example). Never commit real values.
#
# This file is server-side only. Next.js does not read the repository root, so
# browser-safe NEXT_PUBLIC_* values belong in apps/web/.env.example.
# Empty optional values mean "not configured".

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development

API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (local Docker defaults; replace for hosted Postgres)
# ---------------------------------------------------------------------------
POSTGRES_USER=medicare
POSTGRES_PASSWORD=medicare_local_only
POSTGRES_DB=medicare
POSTGRES_PORT=5432
DATABASE_URL=postgresql://medicare:medicare_local_only@localhost:5432/medicare
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Supabase Auth / Storage (optional locally)
# ---------------------------------------------------------------------------
# Hosted project URL, for example https://<project-ref>.supabase.co.
# Local `supabase start` prints the same values for 127.0.0.1:54321.
SUPABASE_URL=
# Server-only. Admin operations (user management, storage) use this key.
# Never prefix it with NEXT_PUBLIC_ and never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The web app receives only the public anon/publishable key as
# NEXT_PUBLIC_SUPABASE_ANON_KEY in apps/web/.env.local.
#
# JWT verification for the API (must match the same Supabase project)
JWT_ISSUER=http://127.0.0.1:54321/auth/v1
JWT_AUDIENCE=authenticated
JWT_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# ---------------------------------------------------------------------------
# Redis / queues
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
QUEUE_PREFIX=medicare

# ---------------------------------------------------------------------------
# AI service
# ---------------------------------------------------------------------------
# disabled | openai-compatible
AI_PROVIDER=disabled
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=800
AI_RETRIEVAL_TOP_K=6
# Comma-separated browser origins allowed to call the internal AI service.
# Empty means no CORS middleware is installed (the intended deployment).
AI_ALLOWED_ORIGINS=
# Shared secret for API -> AI service calls. Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=

# ---------------------------------------------------------------------------
# OCR / document extraction
# ---------------------------------------------------------------------------
# Reserved: no OCR adapter reads these yet. The document worker stays disabled.
OCR_PROVIDER=disabled
OCR_API_URL=
OCR_API_KEY=

# ---------------------------------------------------------------------------
# Maps and geocoding (map tiles need no key; geocoding is optional)
# ---------------------------------------------------------------------------
# Reserved: no geocoding adapter reads these yet.
GEOCODING_PROVIDER=disabled
GEOCODING_API_URL=
GEOCODING_API_KEY=

# ---------------------------------------------------------------------------
# SMS / email (generic HTTP providers; no vendor is hardcoded)
# ---------------------------------------------------------------------------
# Reserved: no SMS or email adapter reads these yet.
SMS_PROVIDER=disabled
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com

# ---------------------------------------------------------------------------
# Provider integrations (all disabled until a real contract exists)
# ---------------------------------------------------------------------------
# Hospital directory provider (API only; server-side).
# `disabled` (default): no data source, honest empty state. No database query is made.
# `manual`: development/sample records only, clearly marked as dev-sample.
#   Never use `manual` in production without a licensed data contract.
# Any other value logs a warning and stays disabled; a typo cannot fake a feed.
HOSPITAL_PROVIDER=disabled
# Reserved until a licensed hospital adapter exists.
HOSPITAL_API_URL=
HOSPITAL_API_KEY=
HOSPITAL_DATA_MAX_AGE_HOURS=24

# Reserved: no pharmacy, doctor or ambulance adapter reads these yet.
PHARMACY_PROVIDER=disabled
PHARMACY_API_URL=
PHARMACY_API_KEY=

DOCTOR_PROVIDER=disabled
DOCTOR_API_URL=
DOCTOR_API_KEY=

AMBULANCE_PROVIDER=disabled
AMBULANCE_API_URL=
AMBULANCE_API_KEY=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# 32+ bytes, base64 or hex. Reserved for encrypting sensitive fields at rest.
# Not yet used by application code; do not assume encryption is active.
ENCRYPTION_KEY=

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100
# Auth routes on the API, and OTP request/verify server actions on the web,
# allow this many attempts per minute per caller (phone/IP).
AUTH_RATE_LIMIT_LIMIT=10

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# Reserved: no metrics exporter reads this yet.
METRICS_ENABLED=false
