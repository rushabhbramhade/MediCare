{
  "name": "@medicare/inventory-sync-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Medicare pharmacy inventory sync worker (no provider integrated)",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@medicare/config": "workspace:*",
    "bullmq": "^6.5.3",
    "ioredis": "^5.11.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
