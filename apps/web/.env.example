# Web app environment. Copy to apps/web/.env.local (next dev reads this file).
# Only NEXT_PUBLIC_* values reach the browser. Never put private keys here.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: leave both empty to run the public pages without hosted auth.
# Patient routes will redirect to /login with a configuration notice.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (used by Next server components / route handlers)
API_BASE_URL=http://localhost:4000

# OpenStreetMap needs no key; keep attribution visible.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
