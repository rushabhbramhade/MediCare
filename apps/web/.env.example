# Web app environment. Copy to apps/web/.env.local (next dev reads this file).
# Only NEXT_PUBLIC_* values reach the browser. Never put private keys here.

NEXT_PUBLIC_APP_URL=http://localhost:3000
# API origin only; the API client appends /v1/... paths.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: leave both empty to run the public pages without hosted auth.
# Patient routes will redirect to /login with a configuration notice.
# Use the Supabase publishable key here (the legacy anon key also works).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (used by Next server components / route handlers).
# Not exposed to the browser.
API_BASE_URL=http://localhost:4000
# OTP request/verify attempts per minute per phone and per IP.
AUTH_RATE_LIMIT_LIMIT=10

# OpenStreetMap needs no key; keep attribution visible.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Google Maps - Browser (safe to expose; used by the Maps JavaScript API).
# Set MAP_PROVIDER=google to use Google Maps; leave osm to keep OpenStreetMap.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_MAP_DEFAULT_LAT=18.5204
NEXT_PUBLIC_MAP_DEFAULT_LNG=73.8567
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=12
NEXT_PUBLIC_MAP_DEFAULT_RADIUS_KM=10
NEXT_PUBLIC_MAP_MAX_RADIUS_KM=50
